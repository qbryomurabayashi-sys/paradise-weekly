rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Catch-all: Deny all access by default ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function getUser(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function getRole() { return getUser(request.auth.uid).role; }
    function isBM() { return isSignedIn() && getRole() == 'BM'; }
    function isAM() { return isSignedIn() && getRole() == 'AM'; }
    function isStoreManager() { return isSignedIn() && getRole() == '店長'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // role × authorRole の閲覧可否（A-2 の visibleAuthorRoles と一致させる）
    //   - BM   : 全 authorRole 可
    //   - AM   : authorRole が '店長' or 'AM'
    //   - 店長 : authorRole が '店長' のみ
    function canViewAuthorRole(authorRole) {
      return isBM()
        || (isAM() && (authorRole in ['店長', 'AM']))
        || (isStoreManager() && (authorRole in ['店長']));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && (
        (request.auth.uid == userId && incoming().role == '店長') ||
        isBM()
      );

      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'lastLoginAt'])) ||
        isBM()
      );

      allow delete: if isBM();

      match /notifications/{notificationId} {
        allow get, list, update, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && incoming().keys().hasAll(['isRead', 'createdAt']);
      }
    }

    // --- Stores Master ---
    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow write: if isBM();
    }

    // --- Staff Master ---
    match /staffs/{staffId} {
      allow read: if isSignedIn();
      allow write: if isBM();
    }

    // --- Shift Requests ---
    match /shift_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().submittedBy == request.auth.uid || isBM());
      allow update, delete: if isSignedIn() && (existing().submittedBy == request.auth.uid || isBM() || isAM());
    }

    // --- Leave Plans ---
    match /leave_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isBM() || isAM() || isStoreManager());
    }

    // --- Store Metrics ---
    match /storeMetrics/{metricId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isBM() || isAM() || (
        isStoreManager() && getUser(request.auth.uid).storeName == get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.name
      ));
    }

    // --- Weekly Reports ---
    match /reports/{reportId} {
      // get: 自分のもの or BM は常に可。それ以外は「公開済み かつ role×authorRole 突合」。
      //   ※ 他人の下書きは従来どおり不可（BMのみ）。BMの authorRole='BM' レポートは店長/AMからは不可になる。
      allow get: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        isBM() ||
        (existing().status != 'draft' && canViewAuthorRole(existing().authorRole))
      );

      // list を厳格化する上での注意（重要）:
      //   Firestore の list ルールはクエリ全体に対して評価されるため、canViewAuthorRole を有効化すると、
      //   クライアント側の購読クエリ（A-2）が where('authorRole','in',[<自ロールの許可集合>]) で
      //   ルールの許可集合と「完全一致」していない限り、list 全体が permission-denied で失敗する。
      //     - 店長 → where('authorRole','in',['店長'])
      //     - AM   → where('authorRole','in',['店長','AM'])
      //     - BM   → where 無し（全件）… isBM() が true になり全 authorRole を許可
      //   したがって A-2 の visibleAuthorRoles() とこの関数の集合は必ず一致させること。
      //   （下書きの status での絞り込みは list では表現できないため、他人の下書き除外は従来どおり
      //     アプリ側ロジックで担保。get 側では上記のとおり他人の下書きを拒否している。）
      allow list: if isSignedIn() && (
        isBM() ||
        canViewAuthorRole(existing().authorRole)
      );

      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId) ||
        isBM() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'readBy', 'commentCount', 'weekNumber'])
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isBM());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                      incoming().authorId == request.auth.uid &&
                      exists(/databases/$(database)/documents/reports/$(reportId));
        allow update: if isSignedIn() && (
          existing().authorId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
        );
        allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isBM());
      }
    }

    // --- Space / Calendar Tasks ---
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isBM() || isAM() || isStoreManager());
    }

    // --- Key / Access Card Management ---
    match /key_passes/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isBM() || isAM() || isStoreManager() || request.auth.uid == userId);
    }

    match /store_key_passes/{storeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isBM() || isAM() || (
        isStoreManager() && getUser(request.auth.uid).storeName == get(/databases/$(database)/documents/stores/$(storeId)).data.name
      ));
    }

    // --- Shared Projects & Chat groups ---
    match /projects/{projectId} {
      allow get: if isSignedIn() && (isBM() || isAM() || request.auth.uid in existing().memberUids || existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (isBM() || isAM() || request.auth.uid in existing().memberUids || existing().authorId == request.auth.uid);
      allow write: if isSignedIn() && (isBM() || isAM() || isStoreManager());

      match /messages/{messageId} {
        allow read: if isSignedIn() && (isBM() || isAM() || request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids);
        allow create: if isSignedIn() &&
                      incoming().authorId == request.auth.uid &&
                      exists(/databases/$(database)/documents/projects/$(projectId));
        allow update, delete: if isSignedIn() && (existing().authorId == request.auth.uid || isBM());
      }
    }

    // --- AI Generated Monthly Insights & Announcements ---
    match /monthly_insights/{insightId} {
      allow read: if isSignedIn();
      allow write: if isBM();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isBM() || isAM();
      allow update: if isBM() || isAM() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['seenBy', 'hiddenBy']));
      allow delete: if isBM();
    }
  }
}
